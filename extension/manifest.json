{
  "manifest_version": 3,
  "name": "Share to My Arcade",
  "version": "1.1.0",
  "description": "One click. A surprise product appears in your Arcade account.",
  "action": {
    "default_title": "Save to My Arcade",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["contextMenus", "activeTab", "scripting", "storage", "tabs", "notifications", "alarms"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
