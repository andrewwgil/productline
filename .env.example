# Required for live Arcade products. Unset = a local mock of Arcade, for UI work.
ARCADE_API_KEY=

# Recommended. GPT reads the portfolio images and plans the line (brand, palette, categories, Arcade prompts).
# Unset = a rules-only read from image pixels and page text.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Mock job latency, used only when ARCADE_API_KEY is unset.
MOCK_JOB_DELAY_MS=600

# Optional. When set, /api/share, /api/shares, and /api/categories require this value in X-Share-Token.
# The Chrome extension and the share page can store it locally. The Arcade key never goes to the client.
SHARE_TOKEN=

# Share persistence, first match wins. Unset uses an in-memory store that resets with the process.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# BLOB_READ_WRITE_TOKEN=
