# Required for live Arcade generation, references, and the style list.
# Unset = mock catalog. Taste still comes from the portfolio images.
ARCADE_API_KEY=

# Optional. When set, Claude writes the taste profile instead of the image palette.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional. When set, Fal adds lifestyle and hero images on top of Arcade art.
FAL_KEY=
FAL_IMAGE_MODEL=fal-ai/flux/schnell

# Mock job latency, used only when ARCADE_API_KEY is unset.
MOCK_JOB_DELAY_MS=600
