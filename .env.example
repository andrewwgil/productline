# Arcade (studio.arcade.ai → Settings → API keys). Unset = realistic mock mode.
ARCADE_API_KEY=
# Claude taste profile. Unset = mock profile.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Fal generative media (lifestyle shots, hero). Unset = skipped.
FAL_KEY=
FAL_IMAGE_MODEL=fal-ai/flux/schnell
# Mock job latency
MOCK_JOB_DELAY_MS=600
